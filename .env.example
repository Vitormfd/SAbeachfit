# ── Banco de dados (Supabase) ─────────────────────────────────────────────
# Supabase → Project → Connect → "Transaction pooler" (porta 6543). Troque [YOUR-PASSWORD].
# Sem esta variável, o projeto usa um Postgres embutido (PGlite) apenas para desenvolvimento local.
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# ── Imagens (Supabase Storage) — OBRIGATÓRIO na Vercel ────────────────────
# Supabase → Project Settings → API. A service_role/secret key é SECRETA: nunca use NEXT_PUBLIC_ nem exponha no navegador.
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Administrador inicial (criado só se ainda não existir nenhum) ─────────
ADMIN_EMAIL=dono@sualoja.com.br
ADMIN_PASSWORD=troque-por-uma-senha-forte
ADMIN_NAME=Proprietária

# ── Site ──────────────────────────────────────────────────────────────────
SITE_URL=https://sua-loja.vercel.app
# "true" carrega produtos de DEMONSTRAÇÃO no primeiro start. Use false em produção.
SEED_DEMO=false
